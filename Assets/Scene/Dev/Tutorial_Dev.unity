  m_Script: {fileID: 11500000, guid: c5ee17677ec06417282e5b3608a8f1c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  hand1Image: {fileID: 1120239724}
  hand2Image: {fileID: 1713090960}
  hand1Duration: 0.3
  hand2Duration: 0.8
  tutorialSequence:
  - groupName: "\uCCAB \uC778\uC0AC"
    messages:
    - "\uBE44\uC804\uB9C1\uACE0\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!"
    - "\uC18C\uB9AC \uC704\uCE58 \uBD84\uBCC4 \uD6C8\uB828\uC5D0 \uC55E\uC11C, \uAC04\uB2E8\uD55C
      \uD29C\uD1A0\uB9AC\uC5BC\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 1
  - groupName: "\uACF5 \uD130\uCE58 \uD6C8\uB828 #1"
    messages:
    - "\uACF5\uC744 \uBC14\uB77C\uBD10 \uC8FC\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uACF5 \uD130\uCE58 \uD6C8\uB828 #2"
    messages:
    - "\uACF5\uC744 \uBC14\uB77C\uBCF8 \uC0C1\uD0DC\uC5D0\uC11C \uC5C4\uC9C0\uC640
      \uAC80\uC9C0\uB97C \uD15D\uD558\uC5EC \uBCF4\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uACF5 \uD130\uCE58 \uD6C8\uB828 #3"
    messages:
    - "\uD15D\uC73C\uB85C \uACF5 \uC120\uD0DD\uC774 \uC131\uACF5\uD588\uC2B5\uB2C8\uB2E4!"
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #1"
    messages:
    - "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 1
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #2"
    messages:
    - "\uC18C\uB9AC\uAC00 \uB098\uB294 \uACF5\uC744 \uC120\uD0DD\uD574 \uC8FC\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #3"
    messages:
    - "\uC54C\uB9DE\uC740 \uACF5\uC744 \uC120\uD0DD\uD558\uBA74 \uACF5\uC774 \uBC1D\uAC8C
      \uBE5B\uB098\uAC8C \uB429\uB2C8\uB2E4."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #4"
    messages:
    - "\uC18C\uB9AC\uAC00 \uB098\uC9C0 \uC54A\uB294 \uACF5\uC744 \uC120\uD0DD\uD574
      \uC8FC\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #5"
    messages:
    - "\uC798\uBABB\uB41C \uACF5\uC744 \uC120\uD0DD\uD558\uBA74 \uACF5\uC774 \uD68C\uC0C9\uC73C\uB85C
      \uBCC0\uD569\uB2C8\uB2E4."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #6"
    messages:
    - "\uACF5\uC744 \uC120\uD0DD\uD558\uC9C0 \uC54A\uACE0 10\uCD08\uAC00 \uC9C0\uB098\uBA74,
      \uC18C\uB9AC\uAC00 \uB098\uB294 \uACF5 \uC8FC\uBCC0\uC758 \uC0C9\uC774 \uC810\uCC28
      \uBCC0\uD569\uB2C8\uB2E4."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC18C\uB9AC \uC704\uCE58 \uD6C8\uB828 #7"
    messages:
    - "\uACF5\uC744 \uC120\uD0DD\uD558\uBA74 \uBCC0\uD654\uB41C \uC0C9\uC740 \uC0AC\uB77C\uC9C0\uAC8C
      \uB429\uB2C8\uB2E4."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC74C\uB7C9 \uC870\uC808 #1"
    messages:
    - "\uC2A4\uC2A4\uB85C\uC5D0\uAC8C \uC54C\uB9DE\uAC8C \uB4E4\uB9AC\uB294 \uC74C\uB7C9\uC73C\uB85C
      \uC870\uC808\uD574 \uC8FC\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 1
  - groupName: "\uC74C\uB7C9 \uC870\uC808 #2"
    messages:
    - "\uC74C\uB7C9 \uC870\uC808 \uC190\uC7A1\uC774\uB97C \uC7A1\uC544 \uB04C\uBA70
      \uC74C\uB7C9 \uC870\uC808 \uC644\uB8CC \uD6C4, \uD6C8\uB828\uC744 \uC2DC\uC791\uD574
      \uC8FC\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
  - groupName: "\uC74C\uB7C9 \uC870\uC808 #3"
    messages:
    - "\uC74C\uB7C9 \uC870\uC808 \uC190\uC7A1\uC774\uB97C \uC7A1\uC544 \uB4DC\uB798\uADF8\uD558\uBA70
      \uC74C\uB7C9 \uC870\uC808 \uC644\uB8CC\uD574 \uC8FC\uC138\uC694."
    extraContent: {fileID: 0}
    extraDuration: 0
    isCenter: 0
